{
  "name": "the-undercity",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs && npm run storylets:check",
    "storylets:generate": "node tools/storylet-generator.mjs generate",
    "storylets:validate": "node tools/storylet-generator.mjs validate",
    "storylets:approve": "node tools/storylet-generator.mjs approve",
    "storylets:publish": "node tools/storylet-generator.mjs publish",
    "storylets:check": "node tools/storylet-generator.mjs publish --check",
    "studio:validate": "node scripts/validate.mjs",
    "studio:report": "node scripts/narrative-studio.mjs report",
    "cms:build": "node tools/cms/build.mjs",
    "cms:check": "node tools/cms/build.mjs --check",
    "build:static": "npm test && npm run studio:validate && node scripts/build-content.mjs --check && node scripts/build-second-acts.mjs --check && node scripts/build-late-main.mjs --check && node scripts/validate-content.mjs && node scripts/content-tracker.mjs --check && node scripts/build-static.mjs"
  }
}
