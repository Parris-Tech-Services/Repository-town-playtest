{
  "name": "neathbound",
  "version": "0.2.0",
  "private": false,
  "description": "An original quality-based narrative browser RPG with a regenerating action pool.",
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 4173 --directory .",
    "test": "node --test",
    "smoke": "node tests/smoke.mjs",
    "api": "node server/index.mjs",
    "api:test": "node --test server/tests/*.test.mjs",
    "validate:content": "node tools/build-gloomwing.mjs --check && node tools/build-catalogue.mjs --check && node tools/validate-content.mjs && npm run cms:check",
    "sync:engine": "node scripts/sync-engine.mjs",
    "release:check": "npm test && npm run api:test && npm run validate:content && npm run smoke && npm run storylets:check && npm run studio:validate",
    "test:e2e": "node --test tests/e2e/play.e2e.mjs",
    "build:content": "node tools/build-gloomwing.mjs",
    "catalogue:build": "node tools/build-catalogue.mjs",
    "storylets:generate": "node tools/storylet-generator.mjs generate",
    "storylets:validate": "node tools/storylet-generator.mjs validate",
    "storylets:approve": "node tools/storylet-generator.mjs approve",
    "storylets:publish": "node tools/storylet-generator.mjs publish",
    "storylets:check": "node tools/storylet-generator.mjs publish --check",
    "studio:validate": "node scripts/validate.mjs",
    "studio:report": "node tools/narrative-studio/validate.mjs report",
    "cms:build": "node tools/cms/build.mjs",
    "cms:check": "node tools/cms/build.mjs --check"
  }
}
